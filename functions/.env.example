# Devcon1 Solutions API — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# ── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=devcon1

# ── Secrets (generate long random strings) ───────────────
# Used to encrypt SMTP/Resend credentials stored in MongoDB
ENCRYPTION_KEY=replace-with-a-long-random-string-at-least-32-chars
# Signs console admin session JWTs
JWT_SECRET=replace-with-another-long-random-string
JWT_EXPIRES_IN=8h
MFA_PENDING_EXPIRES_IN=10m
EMAIL_OTP_TTL_SECONDS=600

# ── HTTP ─────────────────────────────────────────────────
PORT=5050
CORS_ORIGINS=http://localhost:3000,https://devcon1solutions.com,https://www.devcon1solutions.com

# ── Optional bootstrap mailer defaults ───────────────────
# Used to seed mailer_settings on first boot. After that, manage
# credentials from the /console UI (stored encrypted in MongoDB).
DEFAULT_TRANSPORTER_USER=your-address@gmail.com
DEFAULT_TRANSPORTER_PASS=your-google-app-password
DEFAULT_TRANSPORTER_HOST=smtp.gmail.com
DEFAULT_TRANSPORTER_PORT=465
DEFAULT_TRANSPORTER_DELIVER_TO=inbox@devcon1solutions.com
DEFAULT_BRAND_NAME=Devcon1 Solutions
DEFAULT_BRAND_URL=https://devcon1solutions.com

# ── Optional legacy migration ────────────────────────────
# If set, imported once into MongoDB as an API key on first boot
# API_KEY=legacy-shared-secret
