# Devcon1 Solutions API - environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Gmail (or SMTP) account used by nodemailer to send messages
TRANSPORTER_USER=your-address@gmail.com
TRANSPORTER_PASS=your-google-app-password

# Address that receives contact-form submissions
TRANSPORTER_DELIVER_TO=inbox@devcon1solutions.com

# Shared secret expected on inbound API requests
API_KEY=replace-with-a-long-random-string

# Optional branding overrides used in the HTML email template
BRAND_NAME=Devcon1 Solutions
BRAND_URL=https://devcon1solutions.com
BRAND_PRIMARY_COLOR=#0a84ff
BRAND_ACCENT_COLOR=#0b1220
